# Plantilla. Copiar a `.env.local` (ignorado por git) para apuntar a otro
# proyecto de Supabase sin tocar el código. Si `.env.local` no existe, se usan
# los valores por defecto de src/lib/supabase.js.
#
# La key es la PUBLICABLE (sb_publishable_... o la anon key vieja). Nunca la
# secreta (sb_secret_... / service_role): esa no va nunca en el navegador.
#
# El SQL de las tablas y las policies está en docs/supabase.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
